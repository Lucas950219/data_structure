# Copy this file to .env and replace both values before starting the API.
APP_SECRET=replace-with-a-random-secret-of-32-plus-characters
WAITLIST_ADMIN_PASSWORD=replace-with-a-strong-staff-password

# Gmail must have 2-Step Verification and an App Password enabled.
# Leave these unset to reuse gmail_assignment/config.json locally, or set them in the backend host.
# GMAIL_ADDRESS=your-account@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-app-password

# This is the public customer page and the URL embedded in notification emails.
PUBLIC_SITE_URL=https://lucas950219.github.io/data_structure/waitlist.html

# Add the exact frontend origin (scheme + host; no path) and local preview origin.
ALLOWED_ORIGINS=https://lucas950219.github.io,http://127.0.0.1:5500,http://localhost:5500

# Set DATABASE_PATH to a persistent disk path on the backend host.
# DATABASE_PATH=data/waitlist.sqlite3
DEFAULT_WAIT_PER_GROUP_MINUTES=10
HOST=127.0.0.1
PORT=8765
